cd "$WORK_DIR"

# Clean up config on exit
cleanup() {
    rm -rf "$OPENCODE_DIR"
    echo ""
    echo "============================================"
    echo "Optimization Complete"
    echo "============================================"
    echo "Target file: $TARGET_PATH"
    echo "History log: $LOG_FILE"
    echo "============================================"
