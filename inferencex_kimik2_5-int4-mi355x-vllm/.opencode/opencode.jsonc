{
  "$schema": "https://opencode.ai/config.json",
  "model": "amd-anthropic/claude-opus-4-5",
  "default_agent": "inferencex-opt",
  "provider": {
    "amd-anthropic": {
      "options": {
        "timeout": 1200000
      }
    }
  },
  "permission": {
    "*": "allow",
    "bash": "allow",
    "edit": {
      "*": "allow",
      "/opt/*": "deny",
      "/usr/*": "deny"
    },
    "read": "allow",
    "write": {
      "*": "allow",
      "/opt/*": "deny",
      "/usr/*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow"
  }
}